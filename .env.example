# Puerto y URL pública (se usa en los links de los emails)
PORT=3000
BASE_URL=http://localhost:3000

# Acceso al panel de administración (/admin)
ADMIN_USER=admin
ADMIN_PASSWORD=cambiar-esta-clave

# Email donde la farmacia recibe avisos de pedidos y consultas (si no, usa el de Configuración)
ADMIN_EMAIL=

# Servidor de correo (ejemplo Gmail: crear una "contraseña de aplicación" en tu cuenta de Google)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=tu-cuenta@gmail.com
SMTP_PASS=
MAIL_FROM="Farmacia Durand <tu-cuenta@gmail.com>"

# Lectura automática de facturas de compra en PDF o foto (opcional).
# Se obtiene en https://console.anthropic.com → API Keys. Cada factura cuesta aproximadamente entre 5 y 15 centavos de dólar según su largo.
ANTHROPIC_API_KEY=

# Pausa entre emails al enviar una promoción (milisegundos)
MAIL_DELAY_MS=400
